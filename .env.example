# Environment variables for Content Virality Analyzer

# OpenAI API for LLM-powered explanations
OPENAI_API_KEY=your_openai_api_key_here

# Social Media API Keys (optional - for data collection)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
YOUTUBE_API_KEY=your_youtube_api_key

# Model Configuration
VIRALITY_THRESHOLD=2.0
MODEL_TYPE=xgboost
FEATURE_EXTRACTION_BATCH_SIZE=32

# Database Configuration (optional)
DATABASE_URL=sqlite:///virality_data.db

# Logging Level
LOG_LEVEL=INFO

# Feature Extraction Settings
USE_GPU=false
MAX_TEXT_LENGTH=512
IMAGE_SIZE=224

# Benchmarking
VIRAL_CONTENT_DB_PATH=data/viral_benchmark.faiss
SIMILARITY_THRESHOLD=0.8
